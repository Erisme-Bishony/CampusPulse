{
  "openapi": "3.0.3",
  "info": {
    "title": "CampusPulse API",
    "version": "1.0.0",
    "description": "CampusPulse 校园活动平台服务端接口。Base URL 在本机调试时为 http://127.0.0.1:8081；Android 模拟器访问本机时使用 http://10.0.2.2:8081。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8081",
      "description": "本机 IDEA / Apifox 调试"
    },
    {
      "url": "http://10.0.2.2:8081",
      "description": "Android 模拟器访问本机服务端"
    }
  ],
  "tags": [
    {"name": "系统", "description": "健康检查"},
    {"name": "认证", "description": "注册、登录、退出"},
    {"name": "用户", "description": "当前用户资料、兴趣、报名"},
    {"name": "标签", "description": "活动兴趣标签"},
    {"name": "活动", "description": "浏览、搜索、筛选、报名"}
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": ["系统"],
        "summary": "健康检查",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "服务与数据库状态",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/HealthEnvelope"}
              }
            }
          },
          "500": {"$ref": "#/components/responses/InternalError"}
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": ["认证"],
        "summary": "用户注册",
        "operationId": "register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/RegisterRequest"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "注册成功，直接返回 token",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/AuthEnvelope"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "409": {"$ref": "#/components/responses/Conflict"}
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["认证"],
        "summary": "用户登录",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/LoginRequest"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/AuthEnvelope"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": ["认证"],
        "summary": "退出登录",
        "description": "服务端无状态，客户端删除本地 token 即可。",
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "退出成功",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/VoidEnvelope"}
              }
            }
          }
        }
      }
    },
    "/api/v1/users/me": {
      "get": {
        "tags": ["用户"],
        "summary": "当前用户资料",
        "operationId": "me",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {
            "description": "当前用户",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/UserEnvelope"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      },
      "put": {
        "tags": ["用户"],
        "summary": "修改资料",
        "operationId": "updateProfile",
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/UpdateProfileRequest"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "修改后的用户",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/UserEnvelope"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/api/v1/users/me/interests": {
      "get": {
        "tags": ["用户"],
        "summary": "读取兴趣标签",
        "operationId": "getInterests",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {
            "description": "标签 ID 列表",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/IntListEnvelope"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      },
      "put": {
        "tags": ["用户"],
        "summary": "覆盖兴趣标签",
        "operationId": "updateInterests",
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/UpdateInterestsRequest"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "修改后的用户",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/UserEnvelope"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/api/v1/users/me/registrations": {
      "get": {
        "tags": ["用户"],
        "summary": "我的报名",
        "description": "返回该用户全部报名记录，包含 CANCELLED 历史；只显示有效报名时按 status=REGISTERED 过滤。",
        "operationId": "myRegistrations",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {
            "description": "报名记录列表",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/MyRegistrationListEnvelope"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/api/v1/tags": {
      "get": {
        "tags": ["标签"],
        "summary": "标签列表",
        "operationId": "listTags",
        "responses": {
          "200": {
            "description": "按 sort_order 排序的标签",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/TagListEnvelope"}
              }
            }
          }
        }
      }
    },
    "/api/v1/activities": {
      "get": {
        "tags": ["活动"],
        "summary": "活动列表、搜索与筛选",
        "operationId": "listActivities",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "description": "标题/描述/地点/类型关键词；中文至少 2 个字",
            "schema": {"type": "string", "minLength": 2}
          },
          {
            "name": "tagId",
            "in": "query",
            "required": false,
            "description": "标签 ID",
            "schema": {"type": "integer", "format": "int32"}
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "活动类型，如 讲座、比赛、招新、演出",
            "schema": {"type": "string"},
            "example": "讲座"
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "活动开始日期，yyyy-MM-dd",
            "schema": {"type": "string", "format": "date"},
            "example": "2026-10-25"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {"type": "integer", "minimum": 1, "default": 1}
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "每页数量，最大 50",
            "schema": {"type": "integer", "minimum": 1, "maximum": 50, "default": 10}
          }
        ],
        "responses": {
          "200": {
            "description": "分页活动列表，只含 PUBLISHED",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ActivityPageEnvelope"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/BadRequest"}
        }
      }
    },
    "/api/v1/activities/{id}": {
      "get": {
        "tags": ["活动"],
        "summary": "活动详情",
        "operationId": "getActivity",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "活动 ID",
            "schema": {"type": "integer", "format": "int64"}
          }
        ],
        "responses": {
          "200": {
            "description": "活动详情",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ActivityDetailEnvelope"}
              }
            }
          },
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/api/v1/activities/{id}/registrations": {
      "post": {
        "tags": ["活动"],
        "summary": "报名",
        "operationId": "registerActivity",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "活动 ID",
            "schema": {"type": "integer", "format": "int64"}
          }
        ],
        "responses": {
          "200": {
            "description": "报名成功",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/RegistrationEnvelope"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"}
        }
      },
      "delete": {
        "tags": ["活动"],
        "summary": "取消报名",
        "description": "幂等；未报名或已经取消也返回成功。",
        "operationId": "cancelRegistration",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "活动 ID",
            "schema": {"type": "integer", "format": "int64"}
          }
        ],
        "responses": {
          "200": {
            "description": "取消成功",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/VoidEnvelope"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/api/v1/activities/{id}/registration-status": {
      "get": {
        "tags": ["活动"],
        "summary": "我的报名状态",
        "operationId": "registrationStatus",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "活动 ID",
            "schema": {"type": "integer", "format": "int64"}
          }
        ],
        "responses": {
          "200": {
            "description": "报名状态",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/RegistrationStatusEnvelope"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "参数校验失败（40001）",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/ApiError"}
          }
        }
      },
      "Unauthorized": {
        "description": "未登录、token 无效或用户名密码错误（40101/40102）",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/ApiError"}
          }
        }
      },
      "NotFound": {
        "description": "资源不存在（40401）",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/ApiError"}
          }
        }
      },
      "Conflict": {
        "description": "业务冲突：40901 用户名已存在、40902 已报名、40903 名额已满、40904 报名截止",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/ApiError"}
          }
        }
      },
      "InternalError": {
        "description": "服务器内部错误（50000）",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/ApiError"}
          }
        }
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "required": ["code", "message", "timestamp"],
        "properties": {
          "code": {"type": "integer", "example": 0, "description": "0=成功，非 0 为错误码"},
          "message": {"type": "string", "example": "ok"},
          "data": {"nullable": true, "description": "业务数据，失败时为 null"},
          "timestamp": {"type": "string", "example": "2026-10-22 09:00:00"}
        }
      },
      "ApiError": {
        "type": "object",
        "required": ["code", "message", "timestamp"],
        "properties": {
          "code": {"type": "integer", "example": 40902},
          "message": {"type": "string", "example": "已报名，不能重复报名"},
          "data": {"nullable": true, "example": null},
          "timestamp": {"type": "string", "example": "2026-10-22 09:00:00"}
        }
      },
      "HealthEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/ApiResponse"},
          {"type": "object", "properties": {"data": {"$ref": "#/components/schemas/HealthData"}}}
        ]
      },
      "HealthData": {
        "type": "object",
        "required": ["status", "db", "service", "timestamp"],
        "properties": {
          "status": {"type": "string", "example": "UP"},
          "db": {"type": "string", "example": "UP"},
          "service": {"type": "string", "example": "CampusPulseServer"},
          "timestamp": {"type": "string", "example": "2026-10-22 09:00:00"}
        }
      },
      "AuthEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/ApiResponse"},
          {"type": "object", "properties": {"data": {"$ref": "#/components/schemas/AuthData"}}}
        ]
      },
      "AuthData": {
        "type": "object",
        "required": ["token", "user"],
        "properties": {
          "token": {"type": "string", "description": "JWT，有效期 7 天"},
          "user": {"$ref": "#/components/schemas/UserData"}
        }
      },
      "UserEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/ApiResponse"},
          {"type": "object", "properties": {"data": {"$ref": "#/components/schemas/UserData"}}}
        ]
      },
      "UserData": {
        "type": "object",
        "required": ["id", "username", "role", "tagIds"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "username": {"type": "string", "example": "student01"},
          "email": {"type": "string", "nullable": true},
          "phone": {"type": "string", "nullable": true},
          "role": {"type": "string", "example": "USER"},
          "tagIds": {"type": "array", "items": {"type": "integer", "format": "int32"}}
        }
      },
      "IntListEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/ApiResponse"},
          {"type": "object", "properties": {"data": {"type": "array", "items": {"type": "integer", "format": "int32"}}}}
        ]
      },
      "VoidEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/ApiResponse"},
          {"type": "object", "properties": {"data": {"nullable": true, "example": null}}}
        ]
      },
      "TagListEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/ApiResponse"},
          {"type": "object", "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/TagData"}}}}
        ]
      },
      "TagData": {
        "type": "object",
        "required": ["id", "name", "color"],
        "properties": {
          "id": {"type": "integer", "format": "int32"},
          "name": {"type": "string", "example": "学术讲座"},
          "color": {"type": "string", "example": "#4A90D9"}
        }
      },
      "ActivityPageEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/ApiResponse"},
          {"type": "object", "properties": {"data": {"$ref": "#/components/schemas/ActivityPage"}}}
        ]
      },
      "ActivityPage": {
        "type": "object",
        "required": ["items", "total", "page", "size", "totalPages"],
        "properties": {
          "items": {"type": "array", "items": {"$ref": "#/components/schemas/ActivitySummary"}},
          "total": {"type": "integer", "format": "int64", "example": 12},
          "page": {"type": "integer", "example": 1},
          "size": {"type": "integer", "example": 10},
          "totalPages": {"type": "integer", "example": 2}
        }
      },
      "ActivitySummary": {
        "type": "object",
        "required": ["id", "title", "type", "location", "startTime", "endTime", "signupDeadline", "capacity", "signupCount", "remaining", "status", "tags"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "title": {"type": "string", "example": "人工智能前沿讲座"},
          "type": {"type": "string", "example": "讲座"},
          "location": {"type": "string", "example": "图书馆报告厅"},
          "startTime": {"type": "string", "example": "2026-10-25 19:00:00"},
          "endTime": {"type": "string", "example": "2026-10-25 21:00:00"},
          "signupDeadline": {"type": "string", "example": "2026-10-24 19:00:00"},
          "capacity": {"type": "integer", "example": 120},
          "signupCount": {"type": "integer", "example": 36},
          "remaining": {"type": "integer", "example": 84},
          "coverUrl": {"type": "string", "nullable": true},
          "status": {"type": "string", "example": "PUBLISHED"},
          "tags": {"type": "array", "items": {"$ref": "#/components/schemas/TagData"}}
        }
      },
      "ActivityDetailEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/ApiResponse"},
          {"type": "object", "properties": {"data": {"$ref": "#/components/schemas/ActivityDetail"}}}
        ]
      },
      "ActivityDetail": {
        "allOf": [
          {"$ref": "#/components/schemas/ActivitySummary"},
          {
            "type": "object",
            "required": ["description", "viewCount", "shareCount", "createdAt", "updatedAt"],
            "properties": {
              "description": {"type": "string"},
              "organizer": {"type": "string", "nullable": true},
              "viewCount": {"type": "integer", "example": 86},
              "shareCount": {"type": "integer", "example": 5},
              "createdAt": {"type": "string", "example": "2026-10-20 10:00:00"},
              "updatedAt": {"type": "string", "example": "2026-10-20 10:00:00"}
            }
          }
        ]
      },
      "RegistrationEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/ApiResponse"},
          {"type": "object", "properties": {"data": {"$ref": "#/components/schemas/RegistrationData"}}}
        ]
      },
      "RegistrationData": {
        "type": "object",
        "required": ["id", "activityId", "status", "createdAt"],
        "properties": {
          "id": {"type": "integer", "format": "int64", "example": 23},
          "activityId": {"type": "integer", "format": "int64", "example": 1},
          "status": {"type": "string", "enum": ["REGISTERED", "CANCELLED"], "example": "REGISTERED"},
          "createdAt": {"type": "string", "example": "2026-10-22 09:00:00"}
        }
      },
      "RegistrationStatusEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/ApiResponse"},
          {"type": "object", "properties": {"data": {"$ref": "#/components/schemas/RegistrationStatusData"}}}
        ]
      },
      "RegistrationStatusData": {
        "type": "object",
        "required": ["registered", "status"],
        "properties": {
          "registered": {"type": "boolean", "example": true},
          "status": {"type": "string", "enum": ["REGISTERED", "CANCELLED", "NONE"], "example": "REGISTERED"}
        }
      },
      "MyRegistrationListEnvelope": {
        "allOf": [
          {"$ref": "#/components/schemas/ApiResponse"},
          {"type": "object", "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/MyRegistrationData"}}}}
        ]
      },
      "MyRegistrationData": {
        "type": "object",
        "required": ["id", "status", "createdAt", "activity"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "status": {"type": "string", "enum": ["REGISTERED", "CANCELLED"], "example": "REGISTERED"},
          "createdAt": {"type": "string", "example": "2026-10-22 09:00:00"},
          "activity": {"$ref": "#/components/schemas/ActivityBrief"}
        }
      },
      "ActivityBrief": {
        "type": "object",
        "required": ["id", "title", "location", "startTime", "endTime", "status"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "title": {"type": "string"},
          "location": {"type": "string"},
          "startTime": {"type": "string", "example": "2026-10-25 19:00:00"},
          "endTime": {"type": "string", "example": "2026-10-25 21:00:00"},
          "status": {"type": "string", "example": "PUBLISHED"}
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["username", "password", "confirmPassword"],
        "properties": {
          "username": {"type": "string", "minLength": 3, "maxLength": 50, "example": "student07"},
          "password": {"type": "string", "minLength": 6, "maxLength": 64, "format": "password"},
          "confirmPassword": {"type": "string", "minLength": 6, "maxLength": 64, "format": "password"},
          "email": {"type": "string", "format": "email", "maxLength": 100, "nullable": true},
          "phone": {"type": "string", "pattern": "^$|^1\\d{10}$", "nullable": true, "example": "13800138000"},
          "tagIds": {"type": "array", "items": {"type": "integer", "format": "int32"}, "example": [1, 6]}
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": {"type": "string", "example": "student01"},
          "password": {"type": "string", "format": "password", "example": "123456"}
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "email": {"type": "string", "format": "email", "maxLength": 100, "nullable": true},
